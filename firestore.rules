rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /weightLogs/{dateId} {
        allow read, write: if isOwner(uid);
      }

      match /dailyLogs/{dateId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /foods/{foodId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdByUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        resource.data.createdByUid == request.auth.uid ||
        request.auth.uid in resource.data.get('sharedWithUids', [])
      );
    }

    match /connectionInvites/{inviteId} {
      allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid;
      allow read: if isSignedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toEmail == request.auth.token.email
      );
      allow update: if isSignedIn() && resource.data.toEmail == request.auth.token.email;
    }
  }
}
